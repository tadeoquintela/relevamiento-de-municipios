{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relevamiento-de-municipios",
  "compatibility_date": "2026-08-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git/**",
      ".github/**"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
